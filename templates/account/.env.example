# 複製為 .env（已被忽略，勿提交）。哪個平台沒填憑證，那個平台就自動 dry-run。
# 要經營哪些平台，由 platforms.md 決定。

# Threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Bluesky（設定 → 隱私與安全 → App Passwords 產生，不要用主密碼）
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# 自架 PDS 才需要
# BLUESKY_SERVICE=https://bsky.social

# 強制所有平台 dry-run 測試用
# SOCIAL_DRY_RUN=1
